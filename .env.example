# ==============================================================================
# DineAI Environment Configuration Template
# ==============================================================================

# Google Gemini API Key
# Required for all agent skills, embeddings, and reasoning tasks.
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_api_key_here"

# Application Port
# The port the Express server will listen on. Defaults to 3000 if not specified.
PORT=3000

# Environment Mode
# Set to 'production' for optimized static serving and reduced logging.
# Defaults to 'development'.
NODE_ENV="development"

# Security & API Authentication (Optional)
# API_KEY or AUTH_TOKEN sets the expected Bearer token for protected API routes.
# API_KEY="your_secret_api_key"
# AUTH_TOKEN="your_secret_auth_token"

# Allow Unauthenticated Local Development (Optional)
# Set to 'true' to suppress security warnings when running locally without an API_KEY.
ALLOW_UNAUTHENTICATED_LOCAL_DEV="true"

# Gemini Model Overrides (Optional)
# Override default Gemini models defined in src/config/models.ts
# GEMINI_REASONING_MODEL="gemini-2.5-pro"
# GEMINI_TEXT_MODEL="gemini-2.5-flash"
# GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# App URL (Optional)
# Used for self-referential links or deployment-specific routing.
APP_URL="http://localhost:3000"
